# ATOMIC platform configuration
# All settings are optional — defaults run on public keyless RPC endpoints
# and the deterministic demo data plane.

# ── Chain registry ────────────────────────────────────────────────────────
# Chains are configuration, not code. ATOMIC_CHAINS takes a JSON array:
#   • a new id appends a network to the registry
#   • an existing id patches the built-in (only the fields you set change)
# Required for new chains: id, name, evmChainId, nativeSymbol, rpc.
# Optional: short, color (#rrggbb), explorer (https), live, avgGasGwei,
# finalitySec, tokens (ERC-20 contracts probed for live balances and
# transfer logs on the chain — see the README for the schema).
# EIP-155 ids must be unique across the registry; invalid entries are
# skipped with a warning (surfaced at /api/v1/chains and in server
# logs), they never block startup.
# ATOMIC_CHAINS=[{"id":"zksync-era","name":"zkSync Era","evmChainId":324,"nativeSymbol":"ETH","rpc":["https://mainnet.era.zksync.io"],"explorer":"https://explorer.zksync.io","tokens":[{"address":"0x3355df6D4c9C3035724Fd0e3914dE96A5a83aaf4","symbol":"USDC.e","decimals":6}]}]

# Remove chains from the registry (comma-separated ids).
# ATOMIC_CHAINS_DISABLED=avalanche,bnb

# Hot-reloadable chain config: point at a JSON file with the same schema
# as ATOMIC_CHAINS. Edits are detected by a filesystem watcher on the
# file's directory (inotify; catches atomic editor saves) with an
# mtime/size poll per request as fallback — either way the registry is
# re-applied on the spot, no restart. The file is applied on top of
# ATOMIC_CHAINS (file entries win); removing the file reverts to
# env-only configuration.
# ATOMIC_CHAINS_FILE=/etc/atomic/chains.json

# Per-chain JSON-RPC endpoints — replace the defaults (comma-separated
# list enables multi-endpoint failover). Dashes in ids become underscores:
# chain "zksync-era" → ATOMIC_RPC_ZKSYNC_ERA. Set these to dedicated
# (ideally authenticated) endpoints in production.
# NOTE: env vars are frozen once a process starts (an OS constraint) —
# ATOMIC_RPC_*/ATOMIC_CHAINS changes require a restart. The file above
# is the hot-reload path.
# ATOMIC_RPC_ETHEREUM=https://your-node.example.com/v3/key
# ATOMIC_RPC_BASE=https://your-base-node.example.com
# ATOMIC_RPC_ZKSYNC_ERA=

# ── Data plane ────────────────────────────────────────────────────────────
# Disable all live chain reads and run purely on the deterministic demo
# plane (useful for offline CI or air-gapped demos).
# ATOMIC_DISABLE_LIVE=1

# ── Public API ────────────────────────────────────────────────────────────
# Rate limit (requests per minute per IP, /api/v1/*).
# ATOMIC_RATE_LIMIT_RPM=120
