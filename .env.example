# ATOMIC platform configuration
# All settings are optional — defaults run on public keyless RPC endpoints
# and the deterministic demo data plane.

# ── Chain registry ────────────────────────────────────────────────────────
# Chains are configuration, not code. ATOMIC_CHAINS takes a JSON array:
#   • a new id appends a network to the registry
#   • an existing id patches the built-in (only the fields you set change)
# Required for new chains: id, name, evmChainId, nativeSymbol, rpc.
# Optional: short, color (#rrggbb), explorer (https), live, avgGasGwei,
# finalitySec. EIP-155 ids must be unique across the registry; invalid
# entries are skipped with a warning (surfaced at /api/v1/chains and in
# server logs), they never block startup.
# ATOMIC_CHAINS=[{"id":"zksync-era","name":"zkSync Era","evmChainId":324,"nativeSymbol":"ETH","rpc":["https://mainnet.era.zksync.io"],"explorer":"https://explorer.zksync.io"}]

# Remove chains from the registry (comma-separated ids).
# ATOMIC_CHAINS_DISABLED=avalanche,bnb

# Per-chain JSON-RPC endpoints — replace the defaults (comma-separated
# list enables multi-endpoint failover). Dashes in ids become underscores:
# chain "zksync-era" → ATOMIC_RPC_ZKSYNC_ERA. Set these to dedicated
# (ideally authenticated) endpoints in production.
# ATOMIC_RPC_ETHEREUM=https://your-node.example.com/v3/key
# ATOMIC_RPC_BASE=https://your-base-node.example.com
# ATOMIC_RPC_ZKSYNC_ERA=

# ── Data plane ────────────────────────────────────────────────────────────
# Disable all live chain reads and run purely on the deterministic demo
# plane (useful for offline CI or air-gapped demos).
# ATOMIC_DISABLE_LIVE=1

# ── Public API ────────────────────────────────────────────────────────────
# Rate limit (requests per minute per IP, /api/v1/*).
# ATOMIC_RATE_LIMIT_RPM=120
